# ==============================================================================
# ZeroTrace Repository .gitignore
# Components: FastAPI Backend, PyQt5 Desktop App, React (Vite) Web Portal
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage (Test files are tracked; run caches and reports are ignored)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Distribution / Packaging / PyInstaller
build/
dist/
*.manifest
*.spec
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Node / Frontend (React + Vite)
# ------------------------------------------------------------------------------
node_modules/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/
package-lock.json
yarn.lock

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
private_key.pem
public_key.pem
keys/

# ------------------------------------------------------------------------------
# Runtime Logs, Storage & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
uploads/
certificates/
temp/
tmp/
*.journal

# ------------------------------------------------------------------------------
# Editor & OS Metadata
# ------------------------------------------------------------------------------
.vs/
**/.vs/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

tests/
